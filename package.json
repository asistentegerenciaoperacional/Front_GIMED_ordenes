{
  "name": "gimed-ordenes-prototipo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/verify-aria-browser.mjs && node scripts/verify-persistence.mjs",
    "test:ocm": "npm run build && node scripts/verify-material-demand.mjs",
    "test:calendar": "node scripts/verify-calendar-cache.mjs",
    "inventory:aria": "tsx scripts/inventory-aria.ts",
    "benchmark:aria": "node scripts/prepare-aria-baseline.mjs && npm run build && tsx scripts/measure-aria.ts baseline && tsx scripts/measure-aria.ts after && node scripts/compare-aria.mjs",
    "benchmark:favorites": "npm run build && node scripts/benchmark-favorites.mjs",
    "benchmark:ocm": "npm run build && node scripts/benchmark-material-demand.mjs",
    "test:filters": "npm run build && tsx scripts/verify-order-filters.ts",
    "test:detail": "npm run build && node scripts/verify-order-detail.mjs",
    "benchmark:filters": "tsx scripts/benchmark-order-filters.ts",
    "qa": "node scripts/qa-session.mjs",
    "models": "node scripts/model-from-dbml.mjs",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "test:portable": "node scripts/verify-portable.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "latest",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "latest"
  }
}
